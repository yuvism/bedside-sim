{
  "schemaVersion": 1,
  "id": "stemi-01",
  "version": 1,
  "title": "Crushing chest pain",
  "summary": "A 58-year-old taxi driver with 40 minutes of central chest pain, sweaty and grey.",
  "specialty": "Cardiology",
  "difficulty": "core",
  "estMinutes": 20,
  "tags": ["STEMI", "ACS", "VF", "ALS"],
  "patient": {
    "name": "David Okafor",
    "age": 58,
    "sex": "male",
    "weightKg": 92,
    "occupation": "taxi driver",
    "persona": "Stoic, minimises his symptoms, worried about missing work. Clutches his chest and is clearly in pain."
  },
  "brief": [
    "David, {age}, walked into the emergency department with 40 minutes of crushing central chest pain going into his jaw. He is grey and sweaty. He smokes and takes tablets for blood pressure.",
    "Time is muscle. Make the diagnosis, start treatment, get him to the right place — and be ready if his heart rhythm changes."
  ],
  "openingLine": "It's like an elephant sitting on my chest, doc.",
  "baseline": {
    "hr": 78,
    "sbp": 148,
    "dbp": 88,
    "rr": 16,
    "temp": 36.9,
    "glucose": 7.2,
    "hrJitter": 4,
    "sbpJitter": 6
  },
  "labs": {
    "lactate": 1.2,
    "hco3": 24,
    "k": 4.1,
    "na": 139,
    "urea": 6.1,
    "creatinine": 92,
    "hb": 152,
    "wcc": 10.4,
    "plt": 240,
    "troponin": 4
  },
  "processes": [
    {
      "id": "ischaemia",
      "type": "myocardial_ischaemia",
      "label": "Acute myocardial infarction",
      "initial": 45,
      "initialJitter": 4,
      "ratePerMin": 1,
      "rateJitterPct": 10,
      "sensitivityJitterPct": 15,
      "arrestAt": 100,
      "arrestRhythm": "vf",
      "effects": [
        {
          "target": "hr",
          "perPoint": 0.35
        },
        {
          "target": "sbp",
          "perPoint": -0.7,
          "above": 40
        },
        {
          "target": "rr",
          "perPoint": 0.1
        },
        {
          "target": "shunt",
          "perPoint": 0.003,
          "above": 65
        },
        {
          "target": "lab:troponin",
          "perPoint": 3
        },
        {
          "target": "lab:lactate",
          "perPoint": 0.04,
          "above": 60
        },
        {
          "target": "sign:sweating",
          "perPoint": 0.012
        },
        {
          "target": "sign:pain",
          "perPoint": 0.014,
          "group": "pain"
        },
        {
          "target": "sign:ecg_st",
          "perPoint": 0.014,
          "above": 10
        },
        {
          "target": "sign:anxiety",
          "perPoint": 0.01
        }
      ],
      "treatments": [
        {
          "id": "reperfusion",
          "when": {
            "procedure": "pci",
            "forSec": 1200
          },
          "ratePerMin": -6,
          "source": "Primary PCI reperfuses the artery; the cath lab takes about 20 minutes to be ready in this case. Rate is a teaching parameter.",
          "reviewNeeded": true
        }
      ],
      "source": "Teaching model of an evolving anterior STEMI. Effect sizes are teaching parameters.",
      "reviewNeeded": true
    }
  ],
  "rhythmRules": [
    {
      "id": "ischaemic-vf",
      "from": ["sinus", "sinus_tachy", "sinus_brady"],
      "to": "vf",
      "when": {
        "severity": "ischaemia",
        "gte": 55
      },
      "probPerMin": 0.04,
      "source": "Teaching parameter: risk of ischaemic VF while the artery stays occluded.",
      "reviewNeeded": true
    }
  ],
  "bands": {
    "process": "ischaemia",
    "cutoffs": [30, 75]
  },
  "dialogue": [
    {
      "id": "pain",
      "category": "presenting",
      "q": "Tell me about the pain.",
      "a": [
        "It's eased off a lot. Just a dull ache now.",
        "Crushing, right in the middle. Goes up into my jaw and down my left arm.",
        "(clutches his chest, too distressed to answer)"
      ],
      "keywords": ["pain", "chest", "hurt", "describe", "where"]
    },
    {
      "id": "onset",
      "category": "history",
      "q": "When did it start?",
      "a": [
        "About an hour ago now.",
        "Forty minutes ago, lifting a suitcase into the boot.",
        "Forty… minutes…"
      ],
      "keywords": ["when", "start", "began", "long"]
    },
    {
      "id": "breath",
      "category": "presenting",
      "q": "Are you short of breath or sick?",
      "a": ["Not now.", "A bit breathless, and I felt sick in the car.", "(nods, sweating)"],
      "keywords": ["breath", "sick", "nausea", "vomit"]
    },
    {
      "id": "pmh",
      "category": "pmh",
      "q": "Any medical problems?",
      "a": [
        "High blood pressure. Doctor said my cholesterol was up too.",
        "Blood pressure. Cholesterol.",
        "(no answer)"
      ],
      "keywords": ["medical", "history", "conditions", "heart"]
    },
    {
      "id": "meds",
      "category": "meds",
      "q": "What medicines do you take?",
      "a": ["Amlodipine. I was meant to start a statin.", "Amlodipine.", "(no answer)"],
      "keywords": ["medicine", "medicines", "tablets", "medication", "drugs"]
    },
    {
      "id": "allergy",
      "category": "allergies",
      "q": "Any allergies?",
      "a": ["None.", "No.", "(shakes his head)"],
      "keywords": ["allergy", "allergies", "allergic"]
    },
    {
      "id": "smoke",
      "category": "social",
      "q": "Do you smoke?",
      "a": ["Twenty a day for thirty years.", "Twenty a day.", "(nods)"],
      "keywords": ["smoke", "smoking", "cigarettes"]
    },
    {
      "id": "family",
      "category": "family",
      "q": "Any heart problems in the family?",
      "a": ["My dad died of a heart attack at 60.", "Dad… heart attack.", "(nods)"],
      "keywords": ["family", "father", "dad", "mother", "brother"]
    },
    {
      "id": "worry",
      "category": "ice",
      "q": "What's worrying you most?",
      "a": [
        "Whether I can drive the cab again.",
        "Am I having a heart attack?",
        "(grabs your hand)"
      ],
      "keywords": ["worried", "worry", "concern", "scared", "afraid"]
    }
  ],
  "exam": [
    {
      "id": "A",
      "label": "Airway",
      "kind": "abcde",
      "findings": [
        {
          "when": {
            "arrest": true
          },
          "text": "No airway noises. Not breathing."
        },
        {
          "text": "Airway patent, talking."
        }
      ]
    },
    {
      "id": "B",
      "label": "Breathing",
      "kind": "abcde",
      "findings": [
        {
          "when": {
            "arrest": true
          },
          "text": "No respiratory effort."
        },
        {
          "when": {
            "severity": "ischaemia",
            "gte": 65
          },
          "text": "RR {rr}/min, SpO₂ {spo2}% on {o2}. Fine crackles at both bases."
        },
        {
          "text": "RR {rr}/min, SpO₂ {spo2}% on {o2}. Chest clear."
        }
      ]
    },
    {
      "id": "C",
      "label": "Circulation",
      "kind": "abcde",
      "findings": [
        {
          "when": {
            "arrest": true
          },
          "text": "No central pulse."
        },
        {
          "when": {
            "vital": "sbp",
            "lt": 100
          },
          "text": "HR {hr}, BP {sbp}/{dbp}. Cool, clammy, grey. Capillary refill 4 seconds. Heart sounds quiet."
        },
        {
          "text": "HR {hr}, BP {sbp}/{dbp}. Sweaty and pale. Capillary refill 2 seconds. Heart sounds normal, no murmur."
        }
      ]
    },
    {
      "id": "D",
      "label": "Disability",
      "kind": "abcde",
      "findings": [
        {
          "when": {
            "arrest": true
          },
          "text": "Unresponsive. GCS 3/15."
        },
        {
          "text": "GCS {gcs}/15. Alert, in pain. Glucose {glucose:1} mmol/L."
        }
      ]
    },
    {
      "id": "E",
      "label": "Exposure",
      "kind": "abcde",
      "findings": [
        {
          "text": "Temperature {temp:1} °C. No rash. Calves soft, no swelling."
        }
      ]
    },
    {
      "id": "chest",
      "label": "Heart and chest",
      "kind": "region",
      "region": "chest",
      "findings": [
        {
          "when": {
            "severity": "ischaemia",
            "gte": 65
          },
          "text": "Quiet heart sounds, possible third heart sound. Bibasal crackles."
        },
        {
          "text": "Heart sounds normal. Chest clear. Pain not reproducible on pressure."
        }
      ]
    },
    {
      "id": "neck",
      "label": "Neck",
      "kind": "region",
      "region": "neck",
      "findings": [
        {
          "text": "JVP not raised."
        }
      ]
    }
  ],
  "investigations": [
    {
      "id": "ecg",
      "results": [
        {
          "when": {
            "arrest": true
          },
          "text": "No organised rhythm."
        },
        {
          "when": {
            "severity": "ischaemia",
            "gte": 25
          },
          "text": "Sinus rhythm, rate {hr}. 3–4 mm ST elevation in V1–V4 with reciprocal ST depression in II, III and aVF. Anterior STEMI."
        },
        {
          "text": "Sinus rhythm, rate {hr}. Resolving ST elevation in V1–V4 with T-wave inversion."
        }
      ]
    },
    {
      "id": "troponin",
      "orderNote": "Don't wait for troponin: the ECG already makes the diagnosis.",
      "results": [
        {
          "text": "High-sensitivity troponin {troponin} ng/L (raised)."
        }
      ]
    },
    {
      "id": "glu",
      "results": [
        {
          "text": "Glucose {glucose:1} mmol/L."
        }
      ]
    },
    {
      "id": "vbg",
      "results": [
        {
          "text": "pH {ph:2}, HCO₃⁻ {hco3:1} mmol/L, K⁺ {k:1} mmol/L, lactate {lactate:1} mmol/L."
        }
      ]
    },
    {
      "id": "fbc",
      "results": [
        {
          "text": "Hb {hb} g/L, WCC {wcc:1} ×10⁹/L, platelets {plt} ×10⁹/L."
        }
      ]
    },
    {
      "id": "ue",
      "results": [
        {
          "text": "Na {na} mmol/L, K {k:1} mmol/L, urea {urea:1} mmol/L, creatinine {creatinine} µmol/L."
        }
      ]
    },
    {
      "id": "cxr",
      "results": [
        {
          "text": "Normal heart size. Clear lung fields."
        }
      ]
    }
  ],
  "patientLines": [
    {
      "id": "worse",
      "when": {
        "severity": "ischaemia",
        "gte": 60
      },
      "text": "It's getting worse… I feel awful."
    },
    {
      "id": "eased",
      "when": {
        "severity": "ischaemia",
        "lt": 25
      },
      "text": "The pain's nearly gone."
    }
  ],
  "outcomes": {
    "stabilised": {
      "when": {
        "all": [
          {
            "procedure": "pci"
          },
          {
            "severity": "ischaemia",
            "lt": 25
          }
        ]
      },
      "forSec": 120,
      "text": "Artery opened in the cath lab. Pain gone, ST segments settling."
    }
  },
  "diagnosis": {
    "correct": ["stemi"],
    "options": [
      {
        "id": "stemi",
        "label": "Anterior STEMI"
      },
      {
        "id": "nstemi",
        "label": "NSTEMI"
      },
      {
        "id": "dissection",
        "label": "Aortic dissection"
      },
      {
        "id": "pe",
        "label": "Pulmonary embolism"
      },
      {
        "id": "pericarditis",
        "label": "Pericarditis"
      }
    ]
  },
  "scoring": [
    {
      "id": "stabilised",
      "label": "Reperfused and stable",
      "weight": 20,
      "kind": "credit",
      "test": {
        "type": "outcomeIs",
        "outcomes": ["stabilised"]
      }
    },
    {
      "id": "ecg",
      "label": "12-lead ECG within 10 minutes",
      "weight": 15,
      "kind": "credit",
      "critical": true,
      "test": {
        "type": "actionWithin",
        "codes": ["order:ecg"],
        "withinSec": 600
      }
    },
    {
      "id": "pci",
      "label": "Primary PCI activated within 15 minutes",
      "weight": 15,
      "kind": "credit",
      "critical": true,
      "test": {
        "type": "actionWithin",
        "codes": ["procedure:pci"],
        "withinSec": 900
      }
    },
    {
      "id": "aspirin",
      "label": "Aspirin 300 mg",
      "weight": 10,
      "kind": "credit",
      "test": {
        "type": "actionDone",
        "codes": ["drug:aspirin:*"]
      }
    },
    {
      "id": "p2y12",
      "label": "P2Y12 inhibitor loading dose",
      "weight": 5,
      "kind": "credit",
      "test": {
        "type": "actionDone",
        "codes": ["drug:ticagrelor:*"]
      }
    },
    {
      "id": "pads",
      "label": "Defibrillator pads on",
      "weight": 8,
      "kind": "credit",
      "test": {
        "type": "actionDone",
        "codes": ["device:defib_pads:on"]
      }
    },
    {
      "id": "access",
      "label": "IV access",
      "weight": 5,
      "kind": "credit",
      "test": {
        "type": "actionDone",
        "codes": ["procedure:iv_access", "procedure:io_access"]
      }
    },
    {
      "id": "analgesia",
      "label": "Pain treated (nitrate or opioid)",
      "weight": 6,
      "kind": "credit",
      "test": {
        "type": "actionDone",
        "codes": ["drug:gtn:*", "drug:morphine:*"]
      }
    },
    {
      "id": "history",
      "label": "Characterised the pain",
      "weight": 4,
      "kind": "credit",
      "test": {
        "type": "asked",
        "ids": ["pain"]
      }
    },
    {
      "id": "dx",
      "label": "Working diagnosis: STEMI",
      "weight": 5,
      "kind": "credit",
      "test": {
        "type": "diagnosisIs",
        "ids": ["stemi"]
      }
    },
    {
      "id": "no-shock-harm",
      "label": "No inappropriate shocks",
      "weight": 15,
      "kind": "penalty",
      "test": {
        "type": "actionNever",
        "codes": ["adverse:shock_*"]
      }
    },
    {
      "id": "rosc-if-vf",
      "label": "If VF occurred, ROSC achieved",
      "weight": 7,
      "kind": "credit",
      "test": {
        "type": "any",
        "tests": [
          {
            "type": "actionNever",
            "codes": ["arrest"]
          },
          {
            "type": "actionDone",
            "codes": ["rosc"]
          }
        ]
      }
    }
  ],
  "teaching": [
    {
      "id": "ecg-late",
      "text": "Record a 12-lead ECG within 10 minutes of arrival in anyone with chest pain. Here it shows the diagnosis.",
      "showIf": {
        "type": "ruleFailed",
        "id": "ecg"
      }
    },
    {
      "id": "pci-late",
      "text": "Once the ECG shows STEMI, activate primary PCI at once. Don't wait for troponin or other tests.",
      "showIf": {
        "type": "ruleFailed",
        "id": "pci"
      }
    },
    {
      "id": "pads",
      "text": "A STEMI patient can go into VF at any moment. Put defibrillator pads on early so you can shock straight away.",
      "showIf": {
        "type": "ruleFailed",
        "id": "pads"
      }
    },
    {
      "id": "vf",
      "text": "In monitored VF, the first shock is most likely to work when it is delivered within seconds. Each minute without CPR or a shock lowers survival.",
      "showIf": {
        "type": "actionDone",
        "codes": ["arrest"]
      }
    },
    {
      "id": "oxygen",
      "text": "Routine oxygen does not help in ACS when SpO₂ is 90% or above (ESC 2023). Give it for hypoxaemia.",
      "showIf": {
        "type": "actionDone",
        "codes": ["device:o2_*:on"]
      }
    }
  ],
  "references": [
    {
      "id": "esc-acs-2023",
      "label": "Byrne RA, et al. 2023 ESC Guidelines for the management of acute coronary syndromes. European Heart Journal. 2023.",
      "url": "https://www.escardio.org/"
    },
    {
      "id": "rcuk-als-2021",
      "label": "Resuscitation Council UK. Adult advanced life support guidelines. 2021.",
      "url": "https://www.resus.org.uk/"
    }
  ],
  "hints": [
    {
      "id": "ecg",
      "text": "Shall I do a 12-lead ECG?"
    },
    {
      "id": "pads",
      "when": {
        "not": {
          "device": "defib_pads"
        }
      },
      "text": "Do you want the defib pads on him?"
    },
    {
      "id": "pci",
      "when": {
        "not": {
          "procedure": "pci"
        }
      },
      "text": "Do you want me to call the cath lab?"
    }
  ],
  "variation": {
    "ageRange": [50, 68],
    "weightKgRange": [78, 105],
    "options": [
      {
        "id": "diabetic",
        "label": "Type 2 diabetes",
        "chance": 0.3,
        "baseline": {
          "hr": 6
        },
        "severity": 4
      }
    ]
  }
}
