  "teaching": [
    {
      "id": "clock",
      "text": "Oxygen is the clock: the brain tolerates only about four minutes without it. Name an airway operator before the patient arrives and secure a definitive airway while drugs go in.",
      "showIf": {
        "type": "ruleFailed",
        "id": "airway-4min"
      }
    },
    {
      "id": "bag-fails",
      "text": "Bag-mask and supraglottic airways often fail in life-threatening bronchospasm because the pressures needed are too high. If you can't oxygenate, move to front-of-neck access (scalpel–bougie–tube)."
    },
    {
      "id": "brady",
      "text": "A falling heart rate in a hypoxic patient is a pre-arrest sign. Oxygenate first: drugs for the heart rate won't fix it."
    },
    {
      "id": "parallel",
      "text": "Treat the bronchospasm in parallel: salbutamol (in the ventilation circuit or IV), IV magnesium sulfate and steroids, with critical care involved early."
    }
  ],
