{
  "schemaVersion": 1,
  "id": "asthma-02",
  "version": 1,
  "title": "Can't ventilate",
  "summary": "A teenager in life-threatening asthma arrives with paramedics bag-mask ventilating. Saturation won't read and the clock is running.",
  "specialty": "Emergency medicine",
  "difficulty": "advanced",
  "estMinutes": 10,
  "tags": ["asthma", "airway", "peri-arrest", "AMAX4"],
  "patient": {
    "name": "Leo Martin",
    "age": 16,
    "sex": "male",
    "weightKg": 60,
    "occupation": "school student",
    "persona": "Exhausted and hypoxic. Can't speak; responds only with movements while he still can."
  },
  "brief": [
    "Pre-alert: Leo, {age}, known asthmatic, collapsed at home with a severe attack. Paramedics are bag-mask ventilating with great difficulty. Heart rate 140, BP 160/80, saturation not reading. Four minutes away.",
    "Brief your team and assign an airway operator before he arrives. Oxygen is the clock: you have about four minutes to secure oxygenation."
  ],
  "openingLine": "(no speech: eyes half closed, chest barely moving with each squeeze of the bag)",
  "baseline": {
    "hr": 80,
    "sbp": 128,
    "dbp": 70,
    "rr": 16,
    "temp": 37,
    "glucose": 6.5,
    "paco2": 5.3,
    "shunt": 0.01,
    "hrJitter": 3,
    "sbpJitter": 3,
    "source": "Healthy teenage baseline. Teaching values.",
