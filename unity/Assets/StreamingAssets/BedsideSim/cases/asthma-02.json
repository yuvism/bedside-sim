          },
          "text": "HR {hr}: bradycardic, BP {sbp}/{dbp}. Hypoxic bradycardia: arrest is close."
        },
        {
          "text": "HR {hr}, BP {sbp}/{dbp}. Strong central pulse, warm peripheries."
        }
      ]
    },
    {
      "id": "D",
      "label": "Disability",
      "kind": "abcde",
      "findings": [
        {
          "text": "GCS {gcs}. Pupils equal and reactive. Glucose {glucose:1} mmol/L."
        }
      ]
    },
    {
      "id": "E",
      "label": "Exposure",
      "kind": "abcde",
      "findings": [
        {
          "text": "Temperature {temp:1} °C. No rash or swelling. Medical alert bracelet: asthma."
        }
      ]
    }
