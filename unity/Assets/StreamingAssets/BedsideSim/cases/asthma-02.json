        {
          "when": {
            "severity": "bronchospasm",
            "gte": 70
          },
          "text": "Very quiet chest with widespread wheeze. SpO₂ {spo2}% on {o2}."
        },
        {
          "text": "Wheeze improving, better air entry. SpO₂ {spo2}% on {o2}."
        }
      ]
