      "treatments": [
        {
          "id": "failing-bag",
          "when": {
            "not": {
              "any": [
                {
                  "procedure": "tracheal_intubation"
                },
                {
                  "procedure": "front_of_neck_access"
                }
              ]
            }
          },
          "ratePerMin": 2.5,
          "source": "Teaching model of the AMAX4 point that bag-mask ventilation fails in life-threatening bronchospasm: until there is a definitive airway, hypoxia keeps worsening even with drugs.",
          "reviewNeeded": true
        },
        {
          "id": "definitive-airway",
          "when": {
            "any": [
              {
                "procedure": "tracheal_intubation"
              },
              {
                "procedure": "front_of_neck_access"
              }
            ]
          },
          "ratePerMin": -3.933,
          "source": "Teaching model of the AMAX4 principle: oxygenating and ventilating through a definitive airway reverses the hypoxic spiral, while the bronchospasm itself still needs drugs.",
          "reviewNeeded": true
        }
      ],
      "source": "Teaching model of life-threatening asthma with failing bag-mask ventilation, shaped on the AMAX4 simulation video (tachycardia and hypertension on arrival, hypoxic bradycardia from about 1:50 until the surgical airway, recovery after it). Severity, rates and the bradycardia term are teaching parameters. Fitted to \"AMAX4 Simulation MASTER (annotation)\" on 2026-11-11 with Learn from a video. Check before use.",
      "reviewNeeded": true
    }
