# Copy this file to .env (which git ignores) and fill in what you need.

# Teacher console: "Autofill with AI" uses Google Gemini.
# Get a free key at https://aistudio.google.com/apikey
# Free tier: Google may use what you send to improve its products, so use
# only public or de-identified videos you have approval to process.
GEMINI_API_KEY=
# Optional: the model (default gemini-3.6-flash, tested on the AMAX4 video) and the
# models tried next, in order, when one is busy or has used its free requests for
# the day (the free tier allows about 20 a day per model, and "busy" answers count).
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash,gemini-4-hydrogen,gemini-3.5-flash-lite
# GEMINI_MOCK=1 answers from the bundled AMAX4 annotation instead (no key needed).

# Teacher console server (default: this computer only).
PORT=8787
# Online (HOST=0.0.0.0, for example on Render) a sign-in password is required.
# TEACHER_PASSWORD=

# Student app: show cases published from a running teacher console.
# VITE_API_URL=http://localhost:8787
# VITE_TEACHER_URL=http://localhost:8787
# Teacher console: where its "Student app" link goes.
# VITE_STUDENT_URL=http://localhost:5173/bedside-sim/
