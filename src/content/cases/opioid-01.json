{
  "schemaVersion": 1,
  "id": "opioid-01",
  "version": 1,
  "title": "Unresponsive in the toilets",
  "summary": "A 34-year-old found slumped in a toilet cubicle with a needle beside him, barely breathing.",
  "specialty": "Toxicology",
  "difficulty": "foundation",
  "estMinutes": 15,
  "tags": ["opioid overdose", "naloxone", "airway", "hypoventilation"],
