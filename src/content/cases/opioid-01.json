    "hr": 76,
    "sbp": 122,
    "dbp": 74,
    "rr": 14,
    "temp": 36.4,
    "glucose": 5.5,
    "hrJitter": 4,
    "sbpJitter": 4
  },
  "labs": {
    "lactate": 1.2,
    "hco3": 24,
    "k": 4.2,
    "na": 140,
    "urea": 4.5,
    "creatinine": 75,
    "hb": 141,
    "wcc": 7.2,
    "plt": 210
