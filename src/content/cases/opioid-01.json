  "teaching": [
    {
      "id": "airway-first",
      "text": "Airway and breathing come before the antidote: open the airway and ventilate with a bag-valve-mask while someone draws up the naloxone.",
      "showIf": {
        "type": "ruleFailed",
        "id": "airway"
      }
    },
    {
      "id": "titrate",
      "text": "Titrate naloxone to adequate breathing, not to full alertness. Large boluses in someone dependent on opioids cause acute withdrawal and agitation.",
      "showIf": {
        "type": "ruleFailed",
        "id": "titrated"
      }
    },
    {
      "id": "rebound",
      "text": "Naloxone wears off sooner than many opioids. Observe for re-sedation, for at least several hours with long-acting opioids such as methadone."
    },
    {
      "id": "glucose",
      "text": "Check glucose in anyone with reduced consciousness. Hypoglycaemia mimics many overdoses.",
      "showIf": {
        "type": "ruleFailed",
        "id": "glucose"
      }
    }
  ],
