      "label": "Blood transfused",
      "weight": 12,
      "kind": "credit",
      "test": {
        "type": "actionDone",
        "codes": ["fluid:blood"]
      }
    },
    {
      "id": "plasma",
      "label": "Plasma given with the red cells",
      "weight": 5,
      "kind": "credit",
      "test": {
        "type": "actionDone",
        "codes": ["fluid:ffp"]
      }
    },
    {
      "id": "txa",
      "label": "Tranexamic acid given",
      "weight": 10,
      "kind": "credit",
      "test": {
        "type": "actionDone",
        "codes": ["drug:tranexamic_acid:*"]
      }
    },
    {
      "id": "control",
      "label": "Referred for definitive haemorrhage control",
      "weight": 15,
      "kind": "credit",
      "critical": true,
      "test": {
        "type": "actionDone",
        "codes": ["procedure:haemorrhage_control"]
      }
    },
    {
