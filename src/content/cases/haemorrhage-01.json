    },
    {
      "id": "access",
      "label": "Second large-bore IV access",
      "weight": 4,
      "kind": "credit",
      "test": {
        "type": "actionDone",
        "codes": ["procedure:iv_access", "procedure:io_access"]
      }
    },
    {
      "id": "dx",
      "label": "Working diagnosis: haemorrhagic shock",
      "weight": 4,
      "kind": "credit",
      "test": {
        "type": "diagnosisIs",
        "ids": ["pelvic-haemorrhage"]
      }
    },
    {
      "id": "limit-crystalloid",
      "label": "Crystalloid limited (no more than two boluses)",
      "weight": 8,
      "kind": "penalty",
      "test": {
        "type": "actionCount",
        "codes": ["fluid:crystalloid"],
        "max": 2
      }
    },
    {
      "id": "no-pressor",
      "label": "No vasopressor in haemorrhagic shock",
      "weight": 10,
      "kind": "penalty",
      "test": {
        "type": "actionNever",
        "codes": ["infusion:noradrenaline"]
      }
    }
  ],
  "teaching": [
    {
      "id": "binder",
      "text": "Put a pelvic binder on early, at the level of the greater trochanters, in anyone with high-energy injury and suspected pelvic fracture. Don't spring the pelvis.",
      "showIf": {
        "type": "ruleFailed",
        "id": "binder"
      }
    },
    {
      "id": "crystalloid",
      "text": "Large volumes of crystalloid dilute clotting factors and worsen bleeding. Switch to blood and plasma early, and accept a lower blood pressure (permissive hypotension) until the bleeding is controlled, unless there's a head injury.",
      "showIf": {
        "type": "ruleFailed",
        "id": "limit-crystalloid"
      }
    },
    {
      "id": "txa",
      "text": "Tranexamic acid 1 g over 10 minutes, then 1 g over 8 hours, reduces death from bleeding when given within 3 hours of injury (CRASH-2).",
      "showIf": {
        "type": "ruleFailed",
        "id": "txa"
      }
    },
    {
      "id": "definitive",
      "text": "Blood buys time; only haemorrhage control (embolisation or surgery) stops pelvic bleeding. Call early.",
      "showIf": {
        "type": "ruleFailed",
        "id": "control"
      }
    },
    {
      "id": "pressor",
      "text": "Vasopressors don't treat empty vessels. In haemorrhagic shock, give volume and get control.",
      "showIf": {
        "type": "ruleFailed",
        "id": "no-pressor"
      }
    }
  ],
  "references": [
    {
      "id": "atls-10",
      "label": "American College of Surgeons. Advanced Trauma Life Support (ATLS) Student Course Manual. 10th edition. 2018.",
      "url": "https://www.facs.org/"
    },
    {
      "id": "crash-2",
      "label": "CRASH-2 trial collaborators. Effects of tranexamic acid on death, vascular occlusive events, and blood transfusion in trauma patients with significant haemorrhage (CRASH-2). The Lancet. 2010;376:23–32."
    }
  ],
  "hints": [
    {
      "id": "pelvis",
      "text": "She's got bad pelvic pain. Do you want a binder?"
    },
    {
      "id": "blood",
      "when": {
        "vital": "sbp",
        "lt": 90
      },
      "text": "Shall I activate the major haemorrhage protocol?"
    },
    {
      "id": "txa",
      "when": {
        "not": {
          "drugGiven": "tranexamic_acid"
        }
      },
      "text": "Has she had any tranexamic acid?"
    }
  ],
  "variation": {
    "ageRange": [30, 60],
    "weightKgRange": [55, 85]
  }
