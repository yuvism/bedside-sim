{
  "schemaVersion": 1,
  "id": "tension-01",
  "version": 1,
  "title": "Motorbike crash, can't breathe",
  "summary": "A 26-year-old motorcyclist with left chest injuries, getting more breathless and hypotensive by the minute.",
  "specialty": "Trauma",
  "difficulty": "advanced",
  "estMinutes": 15,
  "tags": ["trauma", "tension pneumothorax", "ATLS", "primary survey"],
  "patient": {
    "name": "Ryan Clarke",
    "age": 26,
    "sex": "male",
    "weightKg": 80,
    "occupation": "delivery rider",
    "persona": "Panicky and breathless, in a lot of pain on the left side of his chest."
  },
  "brief": [
    "Ryan, 26, came off his motorbike at about 50 mph and hit a lamp post with the left side of his chest. The ambulance crew put on a collar and gave oxygen. In the last few minutes he has become much more breathless.",
    "Run an ATLS-style primary survey. Treat life threats as you find them."
  ],
  "openingLine": "Can't… breathe… my chest…",
  "baseline": {
    "hr": 88,
    "sbp": 128,
    "dbp": 76,
    "rr": 18,
    "temp": 36.6,
    "glucose": 7,
    "hrJitter": 4,
    "sbpJitter": 4
  },
  "labs": { "lactate": 1.5, "hco3": 24, "k": 4.1, "na": 140, "hb": 145, "wcc": 12, "plt": 250 },
  "processes": [
    {
      "id": "ptx",
      "type": "tension_ptx",
      "label": "Left tension pneumothorax",
      "initial": 45,
      "initialJitter": 4,
      "ratePerMin": 3,
      "rateJitterPct": 10,
      "sensitivityJitterPct": 10,
      "arrestAt": 100,
      "arrestRhythm": "pea",
      "effects": [
        { "target": "shunt", "perPoint": 0.004, "above": 10 },
        { "target": "rr", "perPoint": 0.25 },
        { "target": "hr", "perPoint": 0.5 },
        { "target": "sbp", "perPoint": -1, "above": 30 },
        { "target": "ventLoss", "perPoint": 0.004, "above": 50 },
        { "target": "sign:effort", "perPoint": 0.012 },
        { "target": "sign:anxiety", "perPoint": 0.012 },
        { "target": "sign:sweating", "perPoint": 0.01, "above": 40 }
      ],
      "treatments": [
        {
          "id": "needle",
          "when": { "procedure": "needle_decompression", "withinSec": 900 },
          "ratePerMin": -25,
          "source": "Needle decompression releases the tension but the cannula can kink or block; here it stops working after 15 minutes. Teaching parameters.",
          "reviewNeeded": true
        },
        {
          "id": "drain",
          "when": { "procedure": "chest_drain" },
          "ratePerMin": -25,
          "source": "Chest drain is definitive treatment (ATLS 10th edition, 2018). Rate is a teaching parameter.",
          "reviewNeeded": true
        }
      ],
      "source": "Teaching model of a traumatic tension pneumothorax: obstructive shock with hypoxaemia, arresting within about 20 minutes untreated. Effect sizes are teaching parameters.",
      "reviewNeeded": true
    }
  ],
  "bands": { "process": "ptx", "cutoffs": [25, 65] },
  "dialogue": [
    {
      "id": "what",
      "category": "presenting",
      "q": "Where does it hurt?",
      "a": [
        "Left side of my chest, when I breathe in. Easier now.",
        "Left… chest… can't breathe.",
        "(gasping, points to the left side of his chest)"
      ],
      "keywords": ["hurt", "pain", "where", "happening"]
    },
    {
      "id": "mechanism",
      "category": "history",
      "q": "What happened in the crash?",
      "a": [
        "Lost the back end on a bend and hit a lamp post with my left side.",
        "Hit… lamp post.",
        "(no answer)"
      ],
      "keywords": ["happened", "crash", "accident", "mechanism", "speed"]
    },
    {
      "id": "head",
      "category": "history",
      "q": "Did you hit your head or black out?",
      "a": ["No. The helmet's fine. I remember everything.", "No…", "(shakes his head)"],
      "keywords": ["head", "blackout", "knocked", "unconscious"]
    },
    {
      "id": "pmh",
      "category": "pmh",
      "q": "Any medical problems?",
      "a": ["No, I'm healthy.", "No.", "(no answer)"],
      "keywords": ["medical", "history", "conditions"]
    },
    {
      "id": "meds",
      "category": "meds",
      "q": "Do you take any medicines, especially blood thinners?",
      "a": ["Nothing at all.", "No.", "(no answer)"],
      "keywords": ["medicines", "blood thinners", "anticoagulants", "tablets"]
    },
    {
      "id": "allergy",
      "category": "allergies",
      "q": "Any allergies?",
      "a": ["No.", "No.", "(shakes his head)"],
      "keywords": ["allergy", "allergies", "allergic"]
    },
    {
      "id": "eaten",
      "category": "social",
      "q": "When did you last eat?",
      "a": ["Lunch, about two hours ago.", "Lunch.", "(no answer)"],
      "keywords": ["eat", "eaten", "food", "last meal"]
    }
  ],
  "exam": [
    {
      "id": "A",
      "label": "Airway and C-spine",
      "kind": "abcde",
      "findings": [
        { "when": { "arrest": true }, "text": "No airway noises. Not breathing." },
        { "text": "Airway patent, talking in gasps. Collar on, C-spine immobilised." }
      ]
    },
    {
      "id": "B",
      "label": "Breathing",
      "kind": "abcde",
      "findings": [
        { "when": { "arrest": true }, "text": "No respiratory effort." },
        {
          "when": { "severity": "ptx", "gte": 30 },
          "text": "RR {rr}/min, SpO₂ {spo2}% on {o2}. Trachea deviated to the right. Left chest hyper-resonant with absent breath sounds, moving less. Distended neck veins."
        },
        {
          "when": { "procedure": "chest_drain" },
          "text": "RR {rr}/min, SpO₂ {spo2}% on {o2}. Air entry returning on the left. Drain swinging. Trachea central."
        },
        {
          "text": "RR {rr}/min, SpO₂ {spo2}% on {o2}. Reduced breath sounds on the left, trachea central."
        }
      ]
    },
    {
      "id": "C",
      "label": "Circulation",
      "kind": "abcde",
      "findings": [
        { "when": { "arrest": true }, "text": "No central pulse." },
        {
          "when": { "vital": "sbp", "lt": 90 },
          "text": "HR {hr}, BP {sbp}/{dbp}. Cool, clammy. No external bleeding. Abdomen and pelvis not obviously injured."
        },
        { "text": "HR {hr}, BP {sbp}/{dbp}. No external bleeding. Abdomen soft. Pelvis stable." }
      ]
    },
    {
      "id": "D",
      "label": "Disability",
      "kind": "abcde",
      "findings": [
        { "when": { "arrest": true }, "text": "Unresponsive. GCS 3/15." },
        {
          "text": "GCS {gcs}/15. Pupils equal and reactive. Moving all four limbs. Glucose {glucose:1} mmol/L."
        }
      ]
    },
    {
      "id": "E",
      "label": "Exposure",
      "kind": "abcde",
      "findings": [
        {
          "text": "Temperature {temp:1} °C. Grazes over the left chest wall with crepitus over ribs 5–7. No other injuries found. Kept warm."
        }
      ]
    },
    {
      "id": "neck",
      "label": "Neck",
      "kind": "region",
      "region": "neck",
      "findings": [
        {
          "when": { "severity": "ptx", "gte": 30 },
          "text": "Trachea deviated to the right. Neck veins distended. Some surgical emphysema."
        },
        { "text": "Trachea central. Neck veins not distended." }
      ]
    },
    {
      "id": "chest",
      "label": "Chest",
      "kind": "region",
      "region": "chest",
      "findings": [
        {
          "when": { "severity": "ptx", "gte": 30 },
          "text": "Left: hyper-resonant, silent, moving less. Tender over ribs 5–7. Right: normal."
        },
        { "text": "Left air entry returning. Ribs tender. Right normal." }
      ]
    },
    {
      "id": "abdomen",
      "label": "Abdomen and pelvis",
      "kind": "region",
      "region": "abdomen",
      "findings": [{ "text": "Soft, non-tender. Pelvis stable on gentle examination." }]
    }
  ],
  "investigations": [
    {
      "id": "fast",
      "results": [
        {
          "when": { "severity": "ptx", "gte": 20 },
          "text": "eFAST: no lung sliding on the left (pneumothorax). No free fluid. No pericardial effusion."
        },
        { "text": "eFAST: lung sliding returning on the left. No free fluid." }
      ]
    },
    {
      "id": "cxr",
      "orderNote": "Tension pneumothorax is a clinical diagnosis. Don't wait for an X-ray to decompress.",
      "results": [
        {
          "when": { "severity": "ptx", "gte": 20 },
          "text": "Large left pneumothorax with mediastinal shift to the right. Left rib fractures 5–7."
        },
        { "text": "Left lung re-expanded, drain in a good position. Rib fractures 5–7." }
      ]
    },
    {
      "id": "abg",
      "results": [
        {
          "text": "pH {ph:2}, PaO₂ {pao2:1} kPa, PaCO₂ {paco2:1} kPa, lactate {lactate:1} mmol/L (on {o2})."
        }
      ]
    },
    { "id": "vbg", "results": [{ "text": "pH {ph:2}, lactate {lactate:1} mmol/L, Hb {hb} g/L." }] },
    { "id": "xmatch", "results": [{ "text": "Group O RhD positive. 4 units crossmatched." }] },
    {
      "id": "fbc",
      "results": [{ "text": "Hb {hb} g/L, WCC {wcc:1} ×10⁹/L, platelets {plt} ×10⁹/L." }]
    },
    { "id": "glu", "results": [{ "text": "Glucose {glucose:1} mmol/L." }] }
  ],
  "patientLines": [
    { "id": "worse", "when": { "severity": "ptx", "gte": 70 }, "text": "I'm… going to… die…" },
    {
      "id": "relief",
      "when": { "procedure": "needle_decompression", "withinSec": 30 },
      "text": "Oh… that's… easier."
    }
  ],
  "outcomes": {
    "stabilised": {
      "when": { "all": [{ "procedure": "chest_drain" }, { "severity": "ptx", "lt": 15 }] },
      "forSec": 120,
      "text": "Chest drain in, lung re-expanded, observations settling for 2 minutes."
    }
  },
  "diagnosis": {
    "correct": ["tension"],
    "options": [
      { "id": "tension", "label": "Tension pneumothorax" },
      { "id": "haemothorax", "label": "Massive haemothorax" },
      { "id": "tamponade", "label": "Cardiac tamponade" },
      { "id": "flail", "label": "Flail chest" },
      { "id": "contusion", "label": "Pulmonary contusion" }
    ]
  },
  "scoring": [
    {
      "id": "stabilised",
      "label": "Decompressed, drained and stable",
      "weight": 20,
      "kind": "credit",
      "test": { "type": "outcomeIs", "outcomes": ["stabilised"] }
    },
    {
      "id": "decompress",
      "label": "Decompression within 5 minutes",
      "weight": 20,
      "kind": "credit",
      "critical": true,
      "test": {
        "type": "actionWithin",
        "codes": ["procedure:needle_decompression", "procedure:chest_drain"],
        "withinSec": 300
      }
    },
    {
      "id": "drain",
      "label": "Chest drain placed",
      "weight": 12,
      "kind": "credit",
      "test": { "type": "actionDone", "codes": ["procedure:chest_drain"] }
    },
    {
      "id": "oxygen",
      "label": "High-flow oxygen",
      "weight": 6,
      "kind": "credit",
      "test": { "type": "actionDone", "codes": ["device:o2_nrb:on"] }
    },
    {
      "id": "breathing-exam",
      "label": "Breathing examined before decompressing",
      "weight": 8,
      "kind": "credit",
      "test": {
        "type": "actionBefore",
        "codes": ["exam:B", "exam:chest", "exam:neck"],
        "before": ["procedure:needle_decompression", "procedure:chest_drain"]
      }
    },
    {
      "id": "access",
      "label": "IV access",
      "weight": 5,
      "kind": "credit",
      "test": { "type": "actionDone", "codes": ["procedure:iv_access", "procedure:io_access"] }
    },
    {
      "id": "team",
      "label": "Trauma team called",
      "weight": 5,
      "kind": "credit",
      "test": { "type": "actionDone", "codes": ["help"] }
    },
    {
      "id": "primary-survey",
      "label": "Full primary survey",
      "weight": 6,
      "kind": "credit",
      "test": { "type": "examined", "ids": ["A", "B", "C", "D", "E"] }
    },
    {
      "id": "efast",
      "label": "eFAST performed",
      "weight": 4,
      "kind": "credit",
      "test": { "type": "actionDone", "codes": ["order:fast"] }
    },
    {
      "id": "dx",
      "label": "Working diagnosis: tension pneumothorax",
      "weight": 4,
      "kind": "credit",
      "test": { "type": "diagnosisIs", "ids": ["tension"] }
    },
    {
      "id": "no-xray-delay",
      "label": "Didn't wait for an X-ray before decompressing",
      "weight": 10,
      "kind": "penalty",
      "test": {
        "type": "not",
        "test": {
          "type": "actionBefore",
          "codes": ["order:cxr"],
          "before": ["procedure:needle_decompression", "procedure:chest_drain"]
        }
      }
    }
  ],
  "teaching": [
    {
      "id": "clinical",
      "text": "Tension pneumothorax is a clinical diagnosis: respiratory distress, hypotension, tracheal deviation and an absent, hyper-resonant hemithorax. Decompress first and image afterwards.",
      "showIf": { "type": "ruleFailed", "id": "no-xray-delay" }
    },
    {
      "id": "site",
      "text": "In adults, ATLS (10th edition) recommends needle decompression at the 4th/5th intercostal space just anterior to the mid-axillary line, because the chest wall is thinner there than at the 2nd intercostal space.",
      "showIf": { "type": "actionDone", "codes": ["procedure:needle_decompression"] }
    },
    {
      "id": "drain",
      "text": "Needle decompression is a temporising measure: cannulas kink and block. Follow it with a chest drain.",
      "showIf": { "type": "ruleFailed", "id": "drain" }
    },
    {
      "id": "late",
      "text": "Untreated tension pneumothorax progresses to cardiac arrest in PEA within minutes. Treat it as soon as you recognise it.",
      "showIf": { "type": "ruleFailed", "id": "decompress" }
    }
  ],
  "references": [
    {
      "id": "atls-10",
      "label": "American College of Surgeons. Advanced Trauma Life Support (ATLS) Student Course Manual. 10th edition. 2018.",
      "url": "https://www.facs.org/"
    }
  ]
}
