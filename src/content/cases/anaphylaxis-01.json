  "teaching": [
    {
      "id": "no-adrenaline",
      "text": "IM adrenaline is the first-line treatment for anaphylaxis. Oxygen and fluids buy time but don’t reverse the reaction.",
      "showIf": {
        "type": "ruleFailed",
        "id": "adr-given"
      }
    },
    {
      "id": "late-adrenaline",
      "text": "Adrenaline came late. Give it as soon as anaphylaxis is suspected — airway swelling and low blood pressure won’t wait for a full workup.",
      "showIf": {
        "type": "all",
        "tests": [
          {
            "type": "rulePassed",
            "id": "adr-given"
          },
          {
            "type": "ruleFailed",
            "id": "adr-3min"
          }
        ]
      }
    },
    {
      "id": "second-dose",
      "text": "If there’s no improvement 5 minutes after IM adrenaline, give a second dose.",
      "showIf": {
        "type": "all",
        "tests": [
          {
            "type": "actionCount",
            "codes": ["drug:adrenaline:IM"],
            "min": 1,
            "max": 1
          },
          {
            "type": "ruleFailed",
            "id": "stabilised"
          }
        ]
      }
    },
    {
      "id": "adjuncts-first",
      "text": "An antihistamine or steroid went in before adrenaline. Neither treats airway or circulation problems, so they shouldn’t delay it.",
      "showIf": {
        "type": "actionBefore",
        "codes": ["drug:chlorphenamine:*", "drug:hydrocortisone:*"],
        "before": ["drug:adrenaline:IM"]
      }
    },
    {
      "id": "steroids",
      "text": "Steroids are no longer routinely recommended in the emergency treatment of anaphylaxis (Resuscitation Council UK, 2021).",
      "showIf": {
        "type": "actionDone",
        "codes": ["drug:hydrocortisone:*"]
      }
    },
    {
      "id": "iv-bolus",
      "text": "Undiluted IV adrenaline outside cardiac arrest can cause severe hypertension, arrhythmias and myocardial ischaemia. Refractory cases get a titrated infusion from a specialist.",
      "showIf": {
        "type": "actionDone",
        "codes": ["adverse:iv_bolus_outside_arrest"]
      }
    },
    {
      "id": "tryptase",
      "text": "Good call sending mast cell tryptase — it supports the diagnosis and the allergy referral later.",
      "showIf": {
        "type": "actionDone",
        "codes": ["order:tryp"]
      }
    }
  ],
