    "hr": 80,
    "sbp": 130,
    "dbp": 75,
    "rr": 16,
    "temp": 37,
    "glucose": 6.5,
    "hrJitter": 4,
    "sbpJitter": 5
  },
  "labs": {
    "lactate": 1.2,
    "hco3": 24,
    "k": 4.3,
    "na": 136,
    "urea": 7,
    "creatinine": 80,
    "hb": 118,
    "wcc": 8,
    "plt": 240,
    "crp": 20
  },
