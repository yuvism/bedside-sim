  "version": 1,
  "title": "Feverish and muddled",
  "summary": "A 74-year-old with three days of cough, now confused, hot and hypotensive.",
  "specialty": "Acute medicine",
  "difficulty": "core",
  "estMinutes": 25,
  "tags": ["sepsis", "septic shock", "pneumonia", "vasopressors"],
  "patient": {
    "name": "Margaret Hughes",
    "age": 74,
    "sex": "female",
    "weightKg": 62,
    "occupation": "retired teacher",
    "persona": "Usually sharp and independent. Today muddled and repetitive, keeps asking where her handbag is."
  },
  "brief": [
    "Margaret, 74, was brought in by her daughter. She has had a cough with green sputum for three days and today she is confused, hot and wobbly on her feet. Her daughter says she is \"not herself at all\".",
    "Recognise sepsis early and deliver the bundle in the first hour."
  ],
  "openingLine": "Where's my handbag? I need to get home for the cat.",
