  "teaching": [
    {
      "id": "abx-late",
      "text": "With septic shock, give IV antimicrobials within 1 hour (Surviving Sepsis Campaign 2021). Each hour of delay increases mortality.",
      "showIf": {
        "type": "ruleFailed",
        "id": "antibiotics"
      }
    },
    {
      "id": "pressor",
      "text": "If MAP stays below 65 mmHg after fluid boluses, start noradrenaline. It can be started peripherally while central access is arranged.",
      "showIf": {
        "type": "ruleFailed",
        "id": "pressor"
      }
    },
    {
      "id": "cultures",
      "text": "Take blood cultures before antibiotics where you can, but never delay antibiotics to get them.",
      "showIf": {
        "type": "ruleFailed",
        "id": "cultures-first"
      }
    },
    {
      "id": "lactate",
      "text": "Lactate measures tissue hypoperfusion. Repeat it to check whether resuscitation is working."
    }
  ],
  "references": [
    {
      "id": "ssc-2021",
      "label": "Evans L, et al. Surviving Sepsis Campaign: international guidelines for management of sepsis and septic shock 2021. Critical Care Medicine. 2021.",
